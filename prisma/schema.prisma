generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  processes     Process[] @relation("UserProcesses")
  audits        AuditLog[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // SuperAdmin, Gerente, Analista, Tecnico, Financeiro, Comercial, RH, TI
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique // e.g., "process:create", "finance:view"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String

  @@id([roleId, permissionId])
}

model Process {
  id              String         @id @default(cuid())
  processNumber   String         @unique // Formato 202412.215.32
  status          ProcessStatus  @relation(fields: [statusId], references: [id])
  statusId        String
  insured         String         // Segurado
  insurer         String         // Seguradora
  broker          String?        // Corretora
  merchandise     String?        // Mercadoria
  value           Decimal?       @db.Decimal(15, 2)
  prejudice       Decimal?       @db.Decimal(15, 2) // Prejuízo
  dateOpened      DateTime       @default(now())
  dateDistributed DateTime?
  assignedTo      User?          @relation("UserProcesses", fields: [userId], references: [id])
  userId          String?
  
  // Relations to detail modules
  details         ProcessDetail?
  vistorias       Vistoria[]
  midias          Midia[]
}

model ProcessStatus {
  id        String    @id @default(cuid())
  name      String    @unique // Aberto, Em Andamento, Finalizado, Cancelado
  processes Process[]
}

model ProcessDetail {
  id                String  @id @default(cuid())
  process           Process @relation(fields: [processId], references: [id])
  processId         String  @unique
  preliminaryReport String? @db.Text
  eventDetails      String? @db.Text
  analysis          String? @db.Text
}

model Vistoria {
  id        String   @id @default(cuid())
  process   Process  @relation(fields: [processId], references: [id])
  processId String
  date      DateTime @default(now())
  location  String?
  findings  String?  @db.Text
}

model Midia {
  id        String   @id @default(cuid())
  process   Process  @relation(fields: [processId], references: [id])
  processId String
  url       String
  type      String   // Image, PDF, etc.
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String   // CREATE, UPDATE, DELETE
  entity    String   // table name
  entityId  String
  details   Json?
  createdAt DateTime @default(now())
}
