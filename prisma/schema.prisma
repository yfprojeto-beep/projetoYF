generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation("accounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation("sessions", fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // NextAuth relations
  accounts      Account[] @relation("accounts")
  sessions      Session[] @relation("sessions")
  
  // App relations
  processes      Process[]        @relation("UserProcesses")
  processHistory ProcessHistory[]
  audits         AuditLog[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // SuperAdmin, Gerente, Analista, Tecnico, Financeiro, Comercial, RH, TI
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique // e.g., "process:create", "finance:view"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@id([roleId, permissionId])
}

model Process {
  id              String         @id @default(cuid())
  processNumber   String         @unique // Formato 202412.215.32
  status          ProcessStatus  @relation(fields: [statusId], references: [id])
  statusId        String
  insured         String         // Segurado
  insurer         String         // Seguradora
  broker          String?        // Corretora
  merchandise     String?        // Mercadoria
  value           Decimal?       @db.Decimal(15, 2)
  prejudice       Decimal?       @db.Decimal(15, 2) // Prejuízo
  dateOpened      DateTime       @default(now())
  dateDistributed DateTime?
  assignedTo      User?          @relation("UserProcesses", fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Relations to detail modules
  details         ProcessDetail?
  vistorias       Vistoria[]
  midias          Midia[]
  history         ProcessHistory[]
  adiantamentos   Adiantamento[]
  salvados        Salvado[]
}

model ProcessStatus {
  id        String    @id @default(cuid())
  name      String    @unique // Aberto, Em Andamento, Finalizado, Cancelado
  processes Process[]
}

model ProcessDetail {
  id                String   @id @default(cuid())
  process           Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  processId         String   @unique
  preliminaryReport String?  @db.Text
  eventDetails      String?  @db.Text
  analysis          String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProcessHistory {
  id        String   @id @default(cuid())
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  processId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  date      DateTime @default(now())
  dept      String?
  content   String   @db.Text
  type      String   @default("MANUAL")
}

model Adiantamento {
  id        String   @id @default(cuid())
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  processId String
  value     Decimal  @db.Decimal(15, 2)
  reason    String?  @db.Text
  status    String   @default("PENDENTE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vistoria {
  id            String   @id @default(cuid())
  process       Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  processId     String
  date          DateTime @default(now())
  location      String?
  findings      String?  @db.Text
  status        String   @default("AGENDADO")
  inspectorName String?
  justification String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Midia {
  id        String   @id @default(cuid())
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  processId String
  url       String
  type      String   // Image, PDF, etc.
  createdAt DateTime @default(now())
}

model Salvado {
  id              String         @id @default(cuid())
  process         Process        @relation(fields: [processId], references: [id], onDelete: Cascade)
  processId       String
  lotNumber       String         @unique
  dateSent        DateTime       @default(now())
  storageLocation String?
  status          String         @default("RECEBIDO")
  merchandise     String?
  quantity        String?
  damageDesc      String?        @db.Text
  sender          String?
  receiver        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  propostas       SalvadoProposta[]
  movimentacoes   SalvadoMovimentacao[]
  anexos          SalvadoAnexo[]
}

model SalvadoProposta {
  id        String   @id @default(cuid())
  salvado   Salvado  @relation(fields: [salvadoId], references: [id], onDelete: Cascade)
  salvadoId String
  bidder    String
  value     Decimal  @db.Decimal(15, 2)
  date      DateTime @default(now())
  status    String   @default("PENDENTE")
}

model SalvadoMovimentacao {
  id          String   @id @default(cuid())
  salvado     Salvado  @relation(fields: [salvadoId], references: [id], onDelete: Cascade)
  salvadoId   String
  description String
  date        DateTime @default(now())
  user        String
}

model SalvadoAnexo {
  id        String   @id @default(cuid())
  salvado   Salvado  @relation(fields: [salvadoId], references: [id], onDelete: Cascade)
  salvadoId String
  url       String
  type      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  action    String   // CREATE, UPDATE, DELETE
  entity    String   // table name
  entityId  String
  details   Json?
  createdAt DateTime @default(now())
}

// ==========================================
// MÓDULO DE CADASTROS (MASTER DATA)
// ==========================================

model VistoriadorProfissional {
  id        String   @id @default(cuid())
  name      String
  document  String   @unique // CPF/CNPJ
  email     String?
  phone     String?
  region    String?  // Ex: São Paulo/SP
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Seguradora {
  id        String   @id @default(cuid())
  name      String
  document  String   @unique // CNPJ
  email     String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ==========================================
// MÓDULO FINANCEIRO
// ==========================================

model FinancialTransaction {
  id            String   @id @default(cuid())
  type          String   // RECEITA, DESPESA
  amount        Decimal  @db.Decimal(15, 2)
  description   String
  status        String   @default("PENDENTE") // PENDENTE, PAGO, ATRASADO, CANCELADO
  dueDate       DateTime
  paidDate      DateTime?
  referenceId   String?  // Id do Adiantamento ou SalvadoProposta
  referenceType String?  // Ex: "ADIANTAMENTO", "SALVADO_VENDA"
  createdAt     DateTime @default(now())
}
